# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jhon_aire?schema=public"

# Auth
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Next.js
NEXTAUTH_URL="http://localhost:3000"

# Payments (sandbox/test mode)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Email (transactional)
RESEND_API_KEY="re_..."
EMAIL_FROM="noreply@yourdomain.cl"

# Storage (S3-compatible — use R2, MinIO, or AWS S3)
STORAGE_PROVIDER="s3"
STORAGE_BUCKET="jhon-aire-uploads"
STORAGE_REGION="us-east-1"
STORAGE_ENDPOINT=""           # optional: for R2, MinIO, etc.
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_PUBLIC_URL=""         # optional: public base URL for reading photos

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cron (for scheduled endpoints like /api/maintenance/check)
CRON_SECRET="generate-with-openssl-rand-base64-32"
