# Database (Supabase)
# ──────────────────────────────────────────────────────────────────
# DATABASE_URL = Supavisor transaction-mode pooler (port 6543)
#   Used by PrismaClient at runtime via @prisma/adapter-pg driver adapter.
#   MUST include ?pgbouncer=true to disable named prepared statements
#   (Supavisor transaction mode does not support them).
#   Format: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL = session-mode pooler (port 5432) or direct connection
#   Used by Prisma CLI commands (prisma db push, prisma migrate, prisma generate).
#   Bypasses PgBouncer transaction mode — required because the Schema Engine
#   uses a single-connection transaction that connection poolers don't support.
#   Format: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
#   Or direct: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ──────────────────────────────────────────────────────────────────
# WHY TWO URLs?
# - prisma.config.ts reads DIRECT_URL for CLI operations (migrations, db push, generate).
# - src/lib/db/index.ts reads DATABASE_URL (pooled) for runtime queries.
# - In Prisma 7, url/directUrl are NOT in schema.prisma — they live in prisma.config.ts.
# ──────────────────────────────────────────────────────────────────

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="sb_secret_..."
SUPABASE_JWKS_URL="https://[PROJECT-REF].supabase.co/auth/v1/.well-known/jwks.json"

# Auth
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Next.js
NEXTAUTH_URL="http://localhost:3000"

# Payments (sandbox/test mode)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Email (transactional)
RESEND_API_KEY="re_..."
EMAIL_FROM="noreply@yourdomain.cl"

# Storage (S3-compatible — use R2, MinIO, or AWS S3)
STORAGE_PROVIDER="s3"
STORAGE_BUCKET="jhon-aire-uploads"
STORAGE_REGION="us-east-1"
STORAGE_ENDPOINT=""           # optional: for R2, MinIO, etc.
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_PUBLIC_URL=""         # optional: public base URL for reading photos

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cron (for scheduled endpoints like /api/maintenance/check)
CRON_SECRET="generate-with-openssl-rand-base64-32"
