generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth & Users ───────────────────────────────────────────────

enum Role {
  TECHNICIAN
  OPERATIONS
  SUPPORT
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  role          Role
  phone         String?
  avatarUrl     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  workOrders        WorkOrder[]        @relation("TechnicianWorkOrders")
  assignedOrders    WorkOrder[]        @relation("AssignedByOperations")
  tickets           Ticket[]           @relation("TicketAssignee")
  supportTickets    Ticket[]           @relation("TicketCreator")
  refreshTokens     RefreshToken[]
  activityLogs      ActivityLog[]
  ticketMessages    TicketMessage[]

  @@index([role])
  @@index([email])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─── Products & Catalog ────────────────────────────────────────

enum ProductType {
  SPLIT
  INVERTER
  DUCTED
}

model Product {
  id              String      @id @default(cuid())
  name            String
  slug            String      @unique
  description     String?
  brand           String
  modelNumber     String      @unique
  type            ProductType
  btu             Int
  energyRating    String      // A+, A, B, etc.
  price           Decimal     @db.Decimal(10, 2)
  imageUrl        String?
  features        Json?
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relations
  orderItems      OrderItem[]
  warrantyInfo    WarrantyInfo[]

  @@index([type])
  @@index([btu])
  @@index([energyRating])
  @@index([isActive])
}

// ─── Orders & Payments ─────────────────────────────────────────

enum OrderStatus {
  PENDING
  DEPOSIT_PAID
  PAID
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  FULL
  DEPOSIT
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  status          OrderStatus   @default(PENDING)
  paymentMethod   PaymentMethod

  // Customer info
  customerName    String
  customerEmail   String
  customerPhone   String
  customerAddress String

  // Pricing
  subtotal        Decimal       @db.Decimal(10, 2)
  tax             Decimal       @db.Decimal(10, 2) @default(0)
  total           Decimal       @db.Decimal(10, 2)
  depositRate     Decimal       @db.Decimal(3, 2) @default(0)
  depositAmount   Decimal?      @db.Decimal(10, 2)
  amountPaid      Decimal       @db.Decimal(10, 2) @default(0)
  amountDue       Decimal       @db.Decimal(10, 2)
  balanceDue      Decimal?      @db.Decimal(10, 2)

  // Scheduling
  scheduledDate   DateTime?
  scheduledTime   String?

  // Metadata
  notes           String?
  receiptUrl      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  items           OrderItem[]
  payment         Payment?
  workOrder       WorkOrder?

  @@index([status])
  @@index([customerEmail])
  @@index([orderNumber])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)
  unitPrice Decimal @db.Decimal(10, 2)
  total     Decimal @db.Decimal(10, 2)
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String        @unique
  order             Order         @relation(fields: [orderId], references: [id])
  provider          String        // "stripe" | "webpay" | "mercadopago"
  sessionId         String?       // provider checkout session
  paymentIntentId   String?       // provider payment intent
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("CLP")
  status            PaymentStatus @default(PENDING)
  paidAt            DateTime?
  metadata          Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([sessionId])
  @@index([paymentIntentId])
}

// ─── Work Orders & Field ───────────────────────────────────────

enum WorkOrderStatus {
  CREATED
  ASSIGNED
  EN_ROUTE
  ON_SITE
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model WorkOrder {
  id              String          @id @default(cuid())
  orderId         String?         @unique
  order           Order?          @relation(fields: [orderId], references: [id])
  status          WorkOrderStatus @default(CREATED)
  priority        Int             @default(0) // higher = more urgent

  // Assignment
  technicianId    String?
  technician      User?           @relation("TechnicianWorkOrders", fields: [technicianId], references: [id])
  assignedById    String?
  assignedBy      User?           @relation("AssignedByOperations", fields: [assignedById], references: [id])
  scheduledDate   DateTime?
  scheduledTime   String?

  // Field data
  startedAt       DateTime?
  completedAt     DateTime?
  beforePhotos    Json?           // array of URLs
  afterPhotos     Json?           // array of URLs
  signatureUrl    String?
  safetyChecklist Json?
  suppliesChecklist Json?
  technicianNotes String?
  address         String?
  latitude        Float?
  longitude       Float?

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([technicianId])
  @@index([status])
  @@index([scheduledDate])
}

// ─── Support / After-sales ─────────────────────────────────────

model WarrantyInfo {
  id            String    @id @default(cuid())
  productId     String
  product       Product   @relation(fields: [productId], references: [id])
  orderId       String?
  workOrderId   String?   // WorkOrder that installed this equipment
  serialNumber  String
  brand         String
  model         String
  installDate   DateTime
  lastServiceAt DateTime? // last maintenance visit
  customerName  String
  customerEmail String
  customerPhone String?
  warrantyMonths Int      @default(12)
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tickets       Ticket[]
  alerts        MaintenanceAlert[]

  @@index([serialNumber])
  @@index([customerEmail])
  @@index([workOrderId])
}

// ─── Maintenance Alerts ──────────────────────────────────────

enum AlertType {
  SIX_MONTH
  TWELVE_MONTH
}

enum AlertStatus {
  PENDING
  SENT
  FAILED
}

model MaintenanceAlert {
  id            String      @id @default(cuid())
  warrantyId    String
  warranty      WarrantyInfo @relation(fields: [warrantyId], references: [id])
  alertType     AlertType
  status        AlertStatus @default(PENDING)
  scheduledFor  DateTime    // when the alert should fire
  sentAt        DateTime?
  createdAt     DateTime    @default(now())

  @@unique([warrantyId, alertType]) // idempotency: one alert per warranty per type
  @@index([status, scheduledFor])
  @@index([warrantyId])
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Ticket {
  id              String        @id @default(cuid())
  ticketNumber    String        @unique
  subject         String
  description     String
  status          TicketStatus  @default(OPEN)
  priority        TicketPriority @default(MEDIUM)

  // Relations
  creatorId       String
  creator         User          @relation("TicketCreator", fields: [creatorId], references: [id])
  assigneeId      String?
  assignee        User?         @relation("TicketAssignee", fields: [assigneeId], references: [id])
  warrantyId      String?
  warranty        WarrantyInfo? @relation(fields: [warrantyId], references: [id])

  // SLA
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  dueAt           DateTime?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  messages        TicketMessage[]

  @@index([status])
  @@index([priority])
  @@index([assigneeId])
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id])
  content   String
  isInternal Boolean @default(false)
  createdAt DateTime @default(now())

  @@index([ticketId])
}

// ─── Ticket Counter (atomic numbering) ───────────────────────

model TicketCounter {
  id        String   @id @default(cuid())
  prefix    String   @unique // e.g. "TKT"
  nextValue Int      @default(1)
  updatedAt DateTime @updatedAt
}

// ─── Scheduling ────────────────────────────────────────────────

model TimeSlot {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  startTime   String   // "09:00"
  endTime     String   // "10:00"
  isAvailable Boolean  @default(true)
  orderId     String?
  createdAt   DateTime @default(now())

  @@unique([date, startTime])
  @@index([date])
}

// ─── Activity & Logging ────────────────────────────────────────

model ProcessedEvent {
  id        String   @id @default(cuid())
  eventId   String   @unique
  eventType String
  processedAt DateTime @default(now())

  @@index([eventId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
}
